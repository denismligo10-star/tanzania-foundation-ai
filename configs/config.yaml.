
project:
  name: "Tanzania Foundation AI"
  version: "0.1.0"
  origin: "Tanzania"

model:
  architecture: "transformer"
  name: "tanzania-foundation-model"
  vocab_size: 16000
  max_sequence_length: 512
  embedding_dim: 256
  num_layers: 6
  num_heads: 8
  dropout: 0.1

training:
  batch_size: 4
  learning_rate: 0.0003
  epochs: 5
  weight_decay: 0.01
  seed: 42

data:
  primary_language: "sw"
  languages:
    - "sw"
    - "en"
    - "ha"
    - "yo"
    - "ig"
    - "am"
    - "zu"
  raw_dir: "data/raw"
  processed_dir: "data/processed"

hardware:
  device: "auto"
  mixed_precision: false

evaluation:
  enabled: true
